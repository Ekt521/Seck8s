# ===================== 构建产物 =====================
# Maven 编译输出（必须忽略，不然 jar 包会占用大量空间）
target/
*.jar
*.war
*.ear
*.class

# ===================== IDE 配置（IDEA） =====================
# 忽略 IDEA 项目配置文件，避免不同电脑的 JDK/运行配置冲突
.idea/
*.iml
*.iws
*.ipr
.vscode/
.settings/
.project
.classpath

# ===================== 系统 & 日志 =====================
# Windows 和 Mac 系统生成的无用文件
Thumbs.db
.DS_Store

# 项目运行的日志（启动脚本指向的 logs 目录）
logs/
*.log

# ===================== Python 压测缓存 =====================
# deploy/seckill-test.py 运行时产生的缓存
__pycache__/
*.pyc
venv/
.venv/

# ===================== 中间件本地数据 =====================
# 如果你用 Docker 或本地启动 Nacos/Redis 产生的数据挂载目录
nacos/
data/